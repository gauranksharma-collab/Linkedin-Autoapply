PORT=4500

# MongoDB Atlas connection string
MONGODB_URI=

# Required — no fallback. A forged token here grants control of a live,
# authenticated LinkedIn browser session, so this must be set and kept secret.
JWT_SECRET=

# Frontend origin, for CORS (and WS origin checks)
FRONTEND_ORIGIN=http://localhost:5173

# Groq (https://console.groq.com) — used for AI résumé parsing
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Cloudinary — résumé file storage (server disk isn't persistent across deploys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
